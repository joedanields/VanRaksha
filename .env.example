CAMERA_SOURCE=0
CAMERA_ZONE=Zone-A-North
FRAME_WIDTH=1280
FRAME_HEIGHT=720

YOLO_MODEL_PATH=detection/models/yolov8n.pt
CLASSIFIER_MODEL_PATH=detection/models/species_classifier.pt
NIGHT_MODEL_PATH=
CONFIDENCE_THRESHOLD=0.5
WILD_ANIMAL_LABELS=tiger,elephant,leopard,sloth_bear,wild_boar,gaur,wolf,hyena,nilgai,deer,monkey,peacock
HUMAN_LABELS=person,human
HUMAN_ANIMAL_DISTANCE_RATIO=0.15

NIGHT_START_HOUR=18
NIGHT_END_HOUR=6

TTS_LANGUAGE=en
USE_ONLINE_TTS=false
VOICE_COOLDOWN_SECONDS=30

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OFFICER_PHONE_LIST=+910000000000,+910000000001
SMS_COOLDOWN_MINUTES=10

LED_MODE=mock
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600

FLASK_PORT=5000
FLASK_DEBUG=false

DB_PATH=logger/vanraksha.db
